---
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Eneko Galan - DevOps & Web Developer Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- View Transitions -->
    <ClientRouter />
  </head>
  <body>
    <div id="neon-background">
      <div class="neon-grid"></div>
      <div class="neon-orbs">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
      </div>
    </div>
    <div id="main-content">
      <slot />
    </div>
    <script>
      // @ts-nocheck
      document.addEventListener('DOMContentLoaded', function() {
        const script = document.createElement('script');
        script.src = 'https://unpkg.com/aos@2.3.1/dist/aos.js';
        script.async = true;
        script.onload = function() {
          // Wait a bit for AOS to be available
          setTimeout(function() {
            if (typeof AOS !== 'undefined') {
              AOS.init({
                duration: 1200,
                once: true,
                mirror: false,
                easing: 'ease-out-cubic',
              });
            }
          }, 100);
        };
        script.onerror = function() {
          console.log('AOS failed to load, animations will be disabled');
        };
        document.head.appendChild(script);

      });
    </script>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap');
  :root {
    --bg-primary: #0a0a0f;
    --bg-secondary: #111118;
    --bg-tertiary: #1a1a22;
    --glass-bg: rgba(255, 255, 255, 0.05);
    --glass-border: rgba(255, 255, 255, 0.1);
    --neon-cyan: #00ffff;
    --neon-pink: #ff00ff;
    --neon-purple: #8b5cf6;
    --neon-blue: #3b82f6;
    --neon-green: #00ff88;
    --text-primary: #ffffff;
    --text-secondary: #b8b8d1;
    --text-muted: #8b8ba7;
    --shadow-neon: 0 0 20px rgba(0, 255, 255, 0.3);
    --shadow-pink: 0 0 20px rgba(255, 0, 255, 0.3);
    --shadow-purple: 0 0 20px rgba(139, 92, 246, 0.3);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: Rubik, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
  }

  #neon-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -10;
    pointer-events: none;
    overflow: hidden;
  }

  #main-content {
    position: relative;
    z-index: 10;
    min-height: 100vh;
  }

  .neon-grid {
    position: absolute;
    top: -50px;
    left: -50px;
    width: calc(100% + 100px);
    height: calc(100% + 100px);
    background-image:
      linear-gradient(rgba(0, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: grid-move 20s linear infinite;
  }

  @keyframes grid-move {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
  }

  .neon-orbs {
    position: absolute;
    width: 100%;
    height: 100%;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    animation: float-orb 15s ease-in-out infinite;
  }

  .orb-1 {
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(0, 255, 255, 0.1), transparent);
    top: 20%;
    right: 10%;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(255, 0, 255, 0.1), transparent);
    bottom: 30%;
    left: 10%;
    animation-delay: -5s;
  }

  .orb-3 {
    width: 100px;
    height: 100px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.1), transparent);
    top: 60%;
    right: 30%;
    animation-delay: -10s;
  }

  @keyframes float-orb {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
  }

  .glass {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary) !important;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    background: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink), var(--neon-purple));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradient-shift 3s ease-in-out infinite;
    text-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
  }

  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: var(--text-primary) !important;
    text-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
  }

  h3 {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    color: var(--text-secondary) !important;
  }

  p {
    color: var(--text-secondary) !important;
    font-size: 1.1rem;
    line-height: 1.7;
    position: relative;
    z-index: 1;
  }

  .btn-neon {
    background: transparent;
    border: 2px solid var(--neon-cyan);
    color: var(--neon-cyan);
    padding: 0.875rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    display: inline-block;
    z-index: 1;
  }

  .btn-neon::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.2), transparent);
    transition: left 0.5s;
  }

  .btn-neon:hover::before {
    left: 100%;
  }

  .btn-neon:hover {
    background: var(--neon-cyan);
    color: var(--bg-primary);
    box-shadow: 0 0 20px var(--neon-cyan);
    transform: translateY(-2px);
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--bg-secondary);
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink));
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-purple));
  }

  ::selection {
    background: var(--neon-cyan);
    color: var(--bg-primary);
  }

  *:focus {
    outline: 2px solid var(--neon-cyan);
    outline-offset: 2px;
  }

  * {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  main, section, div, header, article, aside, nav, footer {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 768px) {
    .orb {
      filter: blur(3px);
    }
    
    .orb-1, .orb-2, .orb-3 {
      width: 100px;
      height: 100px;
    }
  }
</style>