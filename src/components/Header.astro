---
import BlinkCursor from './BlinkCursor.astro';
import { INTERESTS, SKILLS } from '../data/constants';
---

<header class="hero-section">
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-text reveal">
        <p class="hero-eyebrow">Portfolio</p>
        <h1 class="hero-title">
          <span class="name-gradient">Eneko Galan</span>
          <div class="title-line"></div>
        </h1>
        <div class="hero-subtitle">
          <span class="role-text">Full Stack Web Developer <BlinkCursor class="blink-light"/></span>
        </div>
        <p class="hero-description">
          Dedicated individual with a passion for new technologies. My experience covers several areas of the technology sector, meeting all the needs of an application throughout its lifecycle, from development to deployment.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-neon btn-magnetic">
            <span>View My Work</span>
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
          <a href="#contact" class="btn btn-neon-pink btn-magnetic">
            <span>Get In Touch</span>
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </a>
        </div>
      </div>
      <div class="hero-visual reveal-left reveal-delay-2">
        <div class="visual-glow"></div>
        <div class="visual-container">
          <div class="code-window glass-card">
            <div class="window-header">
              <div class="window-controls">
                <div class="control close"></div>
                <div class="control minimize"></div>
                <div class="control maximize"></div>
              </div>
              <div class="window-title">about.ts</div>
            </div>
            <div class="window-content">
              <div class="code-line">
                <span class="terminal-prompt">›</span>
                <span class="code-variable">Eneko.contactInfo</span>
              </div>
              <div class="code-line">
                <span class="code-string">["</span><a class="code-link" href="mailto:enekogalanelorza@gmail.com">enekogalanelorza@gmail.com</a><span class="code-string">"</span><span class="code-operator">,</span>
                <span class="code-string">"</span><a class="code-link" href="https://www.linkedin.com/in/eneko-galan" target="_blank" rel="noopener">LinkedIn</a><span class="code-string">"</span><span class="code-operator">,</span>
                <span class="code-string">"</span><a class="code-link" href="https://github.com/egalan" target="_blank" rel="noopener">GitHub</a><span class="code-string">"]</span>
              </div>
              <div class="code-line">
                <span class="terminal-prompt">›</span>
                <span class="code-variable">Eneko.interests</span>
              </div>
              <div class="code-line">
                <span class="code-string">[{INTERESTS.map(interest => `"${interest}"`).join(", ")}]</span>
              </div>
              <div class="code-line">
                <span class="terminal-prompt">›</span>
                <span class="code-variable">Eneko.skills</span>
              </div>
              <div class="code-line">
                <span class="code-string">[{SKILLS.map(skill => `"${skill}"`).join(", ")}]</span>
              </div>
              <div class="code-line code-cursor-line">
                <span class="terminal-prompt">›</span>
                <BlinkCursor />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="scroll-hint reveal reveal-delay-4" aria-hidden="true">
      <span class="scroll-line"></span>
    </div>
  </div>
</header>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: var(--section-padding) 0 3rem;
  }

  .hero-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    width: 100%;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    margin-bottom: 1.25rem;
    opacity: 0.9;
  }

  .hero-text {
    max-width: 580px;
  }

  .role-text {
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
    color: var(--text-secondary);
    font-weight: 500;
    margin-bottom: 1.75rem;
    display: flex;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
  }

  .hero-title {
    margin-bottom: 1.25rem;
  }

  .name-gradient {
    display: block;
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    background: var(--gradient-text);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradient-flow 8s ease infinite;
  }

  .title-line {
    width: 72px;
    height: 3px;
    background: var(--gradient-brand);
    border-radius: 999px;
    margin-top: 1.25rem;
    animation: underline-grow 1s var(--ease-out-expo) 0.4s both;
    box-shadow: 0 0 24px rgba(34, 211, 238, 0.45);
  }

  .hero-description {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 2.25rem;
    max-width: 520px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.35s var(--ease-out-expo);
  }

  .btn:hover .btn-icon {
    transform: translate(2px, -2px);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .visual-glow {
    position: absolute;
    width: 80%;
    height: 80%;
    background: radial-gradient(ellipse, rgba(34, 211, 238, 0.12) 0%, rgba(167, 139, 250, 0.08) 50%, transparent 70%);
    filter: blur(40px);
    animation: pulse-glow 6s ease-in-out infinite;
    pointer-events: none;
  }

  .visual-container {
    position: relative;
    width: 100%;
    max-width: 480px;
  }

  .code-window {
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      var(--shadow-glow-cyan);
    transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s var(--ease-smooth);
  }

  .code-window:hover {
    transform: translateY(-4px) rotateX(2deg);
    box-shadow:
      0 32px 64px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      var(--shadow-glow-cyan),
      var(--shadow-glow-violet);
  }

  .window-header {
    display: flex;
    align-items: center;
    padding: 0.875rem 1rem;
    background: rgba(0, 0, 0, 0.35);
    border-bottom: 1px solid var(--glass-border);
  }

  .window-controls {
    display: flex;
    gap: 0.45rem;
    margin-right: 1rem;
  }

  .control {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    transition: transform 0.2s var(--ease-spring);
  }

  .code-window:hover .control {
    transform: scale(1.1);
  }

  .control.close { background: #ff5f57; }
  .control.minimize { background: #febc2e; }
  .control.maximize { background: #28c840; }

  .window-title {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .window-content {
    padding: 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    line-height: 1.7;
    background: rgba(3, 0, 20, 0.6);
  }

  .code-line {
    margin-bottom: 0.4rem;
    opacity: 0;
    animation: type-in 0.5s var(--ease-out-expo) forwards;
  }

  .code-line:nth-child(1) { animation-delay: 0.4s; }
  .code-line:nth-child(2) { animation-delay: 0.7s; }
  .code-line:nth-child(3) { animation-delay: 1s; }
  .code-line:nth-child(4) { animation-delay: 1.3s; }
  .code-line:nth-child(5) { animation-delay: 1.6s; }
  .code-line:nth-child(6) { animation-delay: 1.9s; }
  .code-line:nth-child(7) { animation-delay: 2.2s; }

  .code-cursor-line {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .code-variable { color: #7dd3fc; }
  .code-string { color: #fde68a; }
  .code-operator { color: #f9a8d4; }
  .terminal-prompt { color: var(--accent-emerald); font-weight: 600; margin-right: 0.35rem; }
  .code-link {
    color: #93c5fd;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .code-link:hover { color: var(--accent-cyan); }

  .scroll-hint {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent-cyan), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .hero-text { max-width: none; margin: 0 auto; }
    .hero-description { max-width: none; margin-left: auto; margin-right: auto; }
    .hero-actions { justify-content: center; }
    .title-line { margin-left: auto; margin-right: auto; }
    .hero-visual { order: -1; }
  }

  @media (max-width: 768px) {
    .hero-actions { flex-direction: column; align-items: stretch; }
    .btn { justify-content: center; }
    .scroll-hint { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .name-gradient,
    .visual-glow,
    .scroll-line,
    .code-line {
      animation: none;
      opacity: 1;
    }
  }
</style>
