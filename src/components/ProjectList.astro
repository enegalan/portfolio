---
import { projects } from "../data/projects";
import BlinkCursor from './BlinkCursor.astro';
---

<section class="projects-section" id="projects">
  <div class="projects-container">
    <div class="section-header" data-aos="fade-up">
      <h2 class="section-title">
        <span class="title-text">Featured Projects</span>
        <BlinkCursor />
        <div class="title-underline"></div>
      </h2>
      <p class="section-description">
        A showcase of my recent work and side projects
      </p>
    </div>
    <div class="projects-timeline">
      {projects.map((project, index) => (
        <div 
          class="project-card glass-card reveal" 
          style={`view-transition-name: project-${index}; --reveal-delay: ${index * 80}ms`}
        >
          <div class="card-header">
            <div class="project-date">
              <span class="month">{project.month}</span>
              <span class="year">{project.year}</span>
            </div>
            <div class="project-status">
              <span class={`status-badge ${project.status.toLowerCase().replace(' ', '-')}`}>
                {project.status}
              </span>
            </div>
          </div>

          <div class="card-content">
            <div class="project-image" style={`view-transition-name: project-image-${index}` }>
              {project.image ? (
                <img src={project.image} alt={project.title} loading="lazy" />
              ) : (
                <div class="placeholder-image">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21,15 16,10 5,21"/>
                  </svg>
                </div>
              )}
              <div class="image-overlay">
                <a href={project.href} target="_blank" rel="noopener noreferrer" class="view-project">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15,3 21,3 21,9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                  View Project
                </a>
              </div>
            </div>
            <div class="project-info">
              <div class="project-meta">
                <span class="project-category">{project.category}</span>
              </div>
              <h3 class="project-title" style={`view-transition-name: project-title-${index}`}>{project.title}</h3>
              <p class="project-description">{project.description}</p>
              <div class="technologies">
                {project.technologies.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
              <div class="project-actions">
                <a href={project.href} target="_blank" rel="noopener noreferrer" class="btn btn-neon-pink">
                  <span>Source Code</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="projects-footer reveal reveal-delay-3">
      <div class="cta-section glass-card">
        <h3>Interested in working together?</h3>
        <p>Let's discuss your next project and bring your ideas to life</p>
        <a href="#contact" class="btn btn-neon btn-large">
          <span>Start a Project</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    const overlayEl = document.createElement('div');
    overlayEl.className = 'projects-overlay';
    document.body.appendChild(overlayEl);
    let isDetailOpen = false;
    function buildDetail(card) {
      const detail = card.cloneNode(true);
      detail.classList.add('project-detail');
      const desc = detail.querySelector('.project-description');
      if (desc) desc.style.removeProperty('-webkit-line-clamp');
      return detail;
    }
    function openProject(card, origin) {
      const run = () => {
        document.querySelector('.project-detail')?.remove();
          const detail = buildDetail(card);
          detail.style.opacity = '0';
          detail.style.filter = 'blur(10px)';
          detail.style.transform = 'translate(-50%, -50%) scale(0.15)';
          document.body.appendChild(detail);
          if (origin) {
            const rect = detail.getBoundingClientRect();
            const ox = Math.max(0, Math.min(1, (origin.x - rect.left) / Math.max(1, rect.width)));
            const oy = Math.max(0, Math.min(1, (origin.y - rect.top) / Math.max(1, rect.height)));
            detail.style.setProperty('--origin-x', (ox * 100).toFixed(2) + '%');
            detail.style.setProperty('--origin-y', (oy * 100).toFixed(2) + '%');
          }
          void detail.getBoundingClientRect();
          detail.style.transition = 'transform 600ms cubic-bezier(.16,.84,.24,1), opacity 600ms cubic-bezier(.16,.84,.24,1), filter 600ms cubic-bezier(.16,.84,.24,1)';
          requestAnimationFrame(() => {
            detail.style.opacity = '1';
            detail.style.filter = 'blur(0)';
            detail.style.transform = 'translate(-50%, -50%) scale(1)';
          });
          overlayEl.classList.add('visible');
          document.body.style.overflow = 'hidden';
          card.setAttribute('aria-expanded', 'true');
          detail.setAttribute('role', 'dialog');
        isDetailOpen = true;
        detail.addEventListener('click', (ev) => ev.stopPropagation());
      };
      run();
    }
    function closeProject() {
      const detail = document.querySelector('.project-detail');
      if (!detail) return;
      const run = () => {
        overlayEl.classList.remove('visible');
        let ended = false;
        const onEnd = () => {
          if (ended) return;
          ended = true;
          detail.removeEventListener('transitionend', onEnd);
          detail.remove();
          document.body.style.overflow = '';
          isDetailOpen = false;
        };
        detail.addEventListener('transitionend', onEnd);
        detail.style.transition = 'transform 420ms cubic-bezier(.3,.7,.2,1), opacity 420ms cubic-bezier(.3,.7,.2,1), filter 420ms cubic-bezier(.3,.7,.2,1)';
        requestAnimationFrame(() => {
          detail.style.opacity = '0';
          detail.style.filter = 'blur(6px)';
          detail.style.transform = 'translate(-50%, -50%) scale(0.86)';
        });
        setTimeout(onEnd, 700);
      };
      run();
    }
    document.addEventListener('click', (e) => {
      if (isDetailOpen) return;
      const detailEl = e.target.closest('.project-detail');
      if (detailEl) return;
      const card = e.target.closest('.project-card');
      if (!card) return;
      openProject(card, { x: e.clientX, y: e.clientY });
    });
    overlayEl.addEventListener('click', (e) => {
      if (e.target === overlayEl) closeProject();
    });
    document.addEventListener('click', (e) => {
      if (!isDetailOpen) return;
      const detail = document.querySelector('.project-detail');
      if (!detail) return;
      const clickInside = detail.contains(e.target);
      const clickOverlay = e.target === overlayEl;
      if (!clickInside && !clickOverlay) closeProject();
    }, true);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeProject(); });
  </script>
</section>

<style>
  .projects-section {
    padding: var(--section-padding) 0;
    position: relative;
  }
  .projects-section {
    --brand-gradient: var(--gradient-brand);
    --brand-shadow: 0 8px 32px rgba(34, 211, 238, 0.12), 0 0 48px rgba(167, 139, 250, 0.08);
  }
  .projects-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }
  .projects-timeline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .project-card {
    border-radius: 18px;
    overflow: hidden;
    transition: transform 0.45s var(--ease-out-expo), box-shadow 0.45s var(--ease-smooth);
    position: relative;
    backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    display: flex;
    flex-direction: column;
    box-shadow: var(--brand-shadow);
    will-change: transform;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gradient-brand-soft);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 0;
  }
  .project-card:hover::before { opacity: 1; }
  .project-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 28px 56px rgba(0, 0, 0, 0.32), 0 0 40px rgba(34, 211, 238, 0.15);
    border-color: rgba(34, 211, 238, 0.2);
  }
  .project-card > * {
    position: relative;
    z-index: 1;
  }
  .project-detail {
    --brand-gradient: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink));
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) !important;
    right: auto;
    bottom: auto;
    width: min(95vw, 900px);
    max-height: 90vh;
    overflow: auto;
    z-index: 1002;
    box-shadow: 0 35px 80px rgba(0,0,0,0.45), 0 0 60px rgba(0, 255, 255, 0.15);
    background: linear-gradient(color-mix(in oklab, var(--bg-primary) 86%, transparent), color-mix(in oklab, var(--bg-primary) 86%, transparent)) padding-box, var(--brand-gradient) border-box;
    backdrop-filter: blur(16px) saturate(120%);
    border: 2px solid transparent;
    transform-origin: var(--origin-x, 50%) var(--origin-y, 50%);
    cursor: default;
    box-shadow: 0 35px 80px rgba(0,0,0,0.45), 0 0 0 1px rgba(255,255,255,0.06) inset, 0 0 38px rgba(0, 255, 255, 0.22), 0 0 28px rgba(255, 0, 255, 0.18);
  }
  .project-detail:hover { transform: translate(-50%, -50%) !important; }
  .project-detail .image-overlay { opacity: 0 !important; }
  .project-detail .card-content { padding: 1.25rem; gap: 1rem; }
  .project-detail .project-image { aspect-ratio: 16/9; max-height: 45vh; }
  .project-detail .project-image img { object-fit: contain; }
  .project-detail .detail-title::after {
    content: '';
    display: block;
    height: 3px;
    width: 80px;
    margin-top: 0.5rem;
    background: var(--brand-gradient);
    box-shadow: 0 0 16px rgba(0, 255, 255, 0.4);
    border-radius: 2px;
  }
  .project-detail.enter { transform: translate(-50%, -50%) scale(.15) !important; opacity: 0; filter: blur(10px); will-change: transform, opacity, filter; }
  .project-detail.enter-active { transform: translate(-50%, -50%) scale(1) !important; opacity: 1; filter: blur(0); transition: transform 600ms cubic-bezier(.16,.84,.24,1), opacity 600ms cubic-bezier(.16,.84,.24,1), filter 600ms cubic-bezier(.16,.84,.24,1); }
  .project-detail.exit { transform: translate(-50%, -50%) scale(.86) !important; opacity: 0; filter: blur(6px); transition: transform 420ms cubic-bezier(.3,.7,.2,1), opacity 420ms cubic-bezier(.3,.7,.2,1), filter 420ms cubic-bezier(.3,.7,.2,1); }
  .card-header { display: none; }
  .project-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg-tertiary);
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.2);
  }
  .month {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neon-cyan);
  }
  .year {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .status-badge {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .status-badge.completed {
    background: rgba(0, 255, 136, 0.1);
    color: var(--neon-green);
    border: 1px solid rgba(0, 255, 136, 0.2);
    box-shadow: 0 0 10px rgba(0, 255, 136, 0.3);
  }
  .status-badge.in-development {
    background: rgba(255, 191, 36, 0.1);
    color: #fbbf24;
    border: 1px solid rgba(255, 191, 36, 0.2);
    box-shadow: 0 0 10px rgba(255, 191, 36, 0.3);
  }
  .status-badge.archived {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.25);
    box-shadow: 0 0 10px rgba(148, 163, 184, 0.2);
  }
  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    flex: 1;
  }
  .project-image {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--bg-tertiary);
  }
  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .project-card:hover .project-image img { transform: scale(1.08); }
  .placeholder-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }
  .placeholder-image svg {
    width: 4rem;
    height: 4rem;
  }
  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .project-card:hover .image-overlay { opacity: 1; }
  .view-project {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--neon-cyan);
    color: var(--bg-primary);
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 0 20px var(--neon-cyan);
  }
  .view-project:hover {
    background: var(--neon-pink);
    box-shadow: 0 0 20px var(--neon-pink);
    transform: translateY(-2px);
  }
  .view-project svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-height: 0;
  }
  .project-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .project-category {
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--glass-border);
  }
  .project-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .project-description {
    color: var(--text-secondary);
    line-height: 1.5;
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tech-tag {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border);
    color: var(--text-secondary);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: transform 0.3s var(--ease-out-expo), border-color 0.3s ease, color 0.3s ease;
  }
  .tech-tag:hover {
    transform: translateY(-2px);
    border-color: rgba(34, 211, 238, 0.35);
    color: var(--accent-cyan);
  }
  .project-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.9rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 0.85rem;
  }
  .btn-neon {
    background: transparent;
    border: 2px solid var(--neon-cyan);
    color: var(--neon-cyan);
  }
  .btn-neon:hover {
    background: var(--neon-cyan);
    color: var(--bg-primary);
    box-shadow: 0 0 20px var(--neon-cyan);
    transform: translateY(-2px);
  }
  .btn-neon-pink {
    background:
      linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
      var(--brand-gradient) border-box;
      border: 2px solid #8d72ff;
    color: var(--neon-pink);
  }
  .btn-neon-pink:hover {
    color: var(--bg-primary);
    background: var(--brand-gradient);
    box-shadow: 0 0 28px rgba(255, 0, 255, 0.4), 0 0 18px rgba(0, 255, 255, 0.35);
    transform: translateY(-2px);
  }
  .btn svg {
    width: 1rem;
    height: 1rem;
  }
  .projects-footer {
    text-align: center;
    margin-top: 4rem;
  }
  .projects-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
    z-index: 1001;
  }
  .projects-overlay.visible {
    opacity: 1;
    pointer-events: auto;
    animation: overlay-in 360ms ease;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 320ms;
    animation-timing-function: cubic-bezier(.2,.8,.2,1);
  }
  .vt-active ::view-transition-old(root),
  .vt-active ::view-transition-new(root) { animation-duration: 380ms; }
  @keyframes overlay-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .cta-section {
    padding: 3rem 2.5rem;
    border-radius: 24px;
    backdrop-filter: blur(24px) saturate(150%);
    background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
    border: 1px solid var(--glass-border);
    max-width: 620px;
    margin: 0 auto;
    box-shadow: var(--shadow-card), var(--shadow-glow-violet);
    transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s var(--ease-smooth);
  }
  .cta-section:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card), var(--shadow-glow-cyan), var(--shadow-glow-violet);
  }
  .cta-section h3 {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  .cta-section p {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }
  .btn-large {
    padding: 1rem 2rem;
    font-size: 1.1rem;
  }
  @media (max-width: 1024px) {
    .projects-timeline { gap: 1rem; }
    .project-image { aspect-ratio: 4/3; }
  }
  @media (max-width: 768px) {
    .projects-section { padding: 4rem 0; }
    .projects-container { padding: 0 1rem; }
    .card-header {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
    .project-actions { flex-direction: column; }
    .btn { justify-content: center; }
  }
</style>
